{
  "name": "fluenticons-next",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "icons": "node scripts/build-icon-data.mjs",
    "dev": "yarn icons && nuxt dev",
    "build": "yarn icons && nuxt build",
    "generate": "yarn icons && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nuxt generate",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare",
    "material:icons": "node scripts/build-icon-data.mjs sites/material",
    "material:dev": "yarn material:icons && nuxt dev sites/material",
    "material:generate": "yarn material:icons && node -e \"require('fs').rmSync('sites/material/dist',{recursive:true,force:true})\" && nuxt generate sites/material"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "marked": "^16"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.19.0"
  }
}
